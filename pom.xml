<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.nmoncho</groupId>
  <artifactId>faradn-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Farad'n Parent</name>
  <description>HTML-to-ESC/POS printing for Java: write your receipt as HTML, print it on paper.</description>
  <url>https://github.com/nMoncho/faradn</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>nMoncho</id>
      <name>Gustavo De Micheli</name>
      <url>https://github.com/nMoncho</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/nMoncho/faradn.git</connection>
    <developerConnection>scm:git:git@github.com:nMoncho/faradn.git</developerConnection>
    <url>https://github.com/nMoncho/faradn</url>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/nMoncho/faradn/issues</url>
  </issueManagement>

  <modules>
    <module>faradn-core</module>
    <module>faradn-cli</module>
    <module>faradn-ffi</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Reproducible builds: bump per release (or set from the tag). -->
    <project.build.outputTimestamp>2026-08-25T00:00:00Z</project.build.outputTimestamp>
    <formatter.version>2.23.0</formatter.version>
    <enforcer.version>3.4.1</enforcer.version>
    <surefire.version>3.2.5</surefire.version>
    <shade.version>3.6.0</shade.version>
    <nativemaven.version>0.10.3</nativemaven.version>
    <graalsdk.version>23.0.2</graalsdk.version>
    <usb4java.version>1.3.0</usb4java.version>
    <typesafeconfig.version>1.4.3</typesafeconfig.version>
    <slf4j.version>2.0.13</slf4j.version>
    <jsoup.version>1.17.2</jsoup.version>
    <picocli.version>4.7.6</picocli.version>
    <junit.version>5.10.2</junit.version>
    <logback.version>1.5.6</logback.version>
    <mockito.version>5.11.0</mockito.version>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>net.revelc.code.formatter</groupId>
        <artifactId>formatter-maven-plugin</artifactId>
        <version>${formatter.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>format</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <encoding>UTF-8</encoding>
          <configFile>${maven.multiModuleProjectDirectory}/eclipse-formatter.xml</configFile>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <configuration>
          <argLine>-XX:+EnableDynamicAgentLoading</argLine>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${surefire.version}</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${enforcer.version}</version>
        <executions>
          <execution>
            <id>enforce</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[17,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.8,)</version>
                </requireMavenVersion>
                <dependencyConvergence/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      usb4java 1.3.0 bundles libusb4java natives for darwin-x86-64,
      linux-x86-64, linux-aarch64 and Windows, but NOT darwin-aarch64
      (Apple Silicon). On that platform we add the native explicitly. It is
      not published to Maven Central, so it must be built and installed into
      the local repository once:

        mvn install:install-file -Dfile=libusb4java-1.3.0-darwin-aarch64.jar \
          -DgroupId=org.usb4java -DartifactId=libusb4java -Dversion=1.3.0 \
          -Dclassifier=darwin-aarch64 -Dpackaging=jar

      On every other OS/arch this profile stays inactive and usb4java resolves
      the correct native transitively from Maven Central. It is inherited by the
      modules that put the USB code on their classpath.
    -->
    <profile>
      <id>macos-aarch64</id>
      <activation>
        <os>
          <family>mac</family>
          <arch>aarch64</arch>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.usb4java</groupId>
          <artifactId>libusb4java</artifactId>
          <version>${usb4java.version}</version>
          <classifier>darwin-aarch64</classifier>
        </dependency>
      </dependencies>
    </profile>

    <!--
      Release artifacts: source + javadoc jars, GPG signatures, and publishing to
      Maven Central via the Sonatype Central Portal. Active only with -Prelease.

      Before the first publish, confirm: (1) the io.nmoncho namespace is verified on
      central.sonatype.com; (2) a `central` server with a Central user token lives in
      settings.xml; (3) a GPG signing key is available. Then dry-run with
      `mvn -Prelease -DskipTests verify` before `deploy`.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution>
                <id>attach-javadoc</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.4</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.5.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
