<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>net.nmoncho</groupId>
  <artifactId>faradn-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Farad'n Parent</name>
  <description>HTML-to-ESC/POS printing for Java: write your receipt as HTML, print it on paper.</description>
  <url>https://github.com/nMoncho/faradn</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>nMoncho</id>
      <name>Gustavo De Micheli</name>
      <url>https://github.com/nMoncho</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/nMoncho/faradn.git</connection>
    <developerConnection>scm:git:git@github.com:nMoncho/faradn.git</developerConnection>
    <url>https://github.com/nMoncho/faradn</url>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/nMoncho/faradn/issues</url>
  </issueManagement>

  <modules>
    <module>faradn-core</module>
    <module>faradn-cli</module>
    <module>faradn-ffi</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Reproducible builds: bump per release (or set from the tag). -->
    <project.build.outputTimestamp>2026-09-09T14:34:33Z</project.build.outputTimestamp>
    <formatter.version>2.29.0</formatter.version>
    <enforcer.version>3.6.3</enforcer.version>
    <surefire.version>3.5.6</surefire.version>
    <shade.version>3.6.2</shade.version>
    <jar.version>3.5.0</jar.version>
    <cyclonedx.version>2.9.1</cyclonedx.version>
    <licensemojo.version>2.5.0</licensemojo.version>
    <licenseheader.version>4.6</licenseheader.version>
    <nativemaven.version>0.10.3</nativemaven.version>
    <!-- Must match the GraalVM used to build the native images. JDK 17 GraalVM
         is the 23.0.x line (17.0.9-graalce == 23.0.2); do not bump past 23.0.x
         without also upgrading GraalVM. -->
    <graalsdk.version>23.0.2</graalsdk.version>
    <usb4java.version>1.3.0</usb4java.version>
    <typesafeconfig.version>1.4.9</typesafeconfig.version>
    <slf4j.version>2.0.18</slf4j.version>
    <jsoup.version>1.23.2</jsoup.version>
    <picocli.version>4.7.7</picocli.version>
    <junit.version>6.1.3</junit.version>
    <logback.version>1.6.3</logback.version>
    <mockito.version>5.23.0</mockito.version>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <!--
          THIRD-PARTY.txt generator. Kept in pluginManagement (not the active
          plugin list) on purpose: it shares the `license` goal prefix with the
          com.mycila license-maven-plugin below, and only one plugin can own a
          prefix. Parking it here lets `license:format` / `license:check` resolve
          to the mycila header plugin, while this one stays runnable by its full
          coordinates (see RELEASING.md), picking up the config below:
            mvn org.codehaus.mojo:license-maven-plugin:aggregate-add-third-party
        -->
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>license-maven-plugin</artifactId>
          <version>${licensemojo.version}</version>
          <configuration>
            <outputDirectory>${maven.multiModuleProjectDirectory}</outputDirectory>
            <thirdPartyFilename>THIRD-PARTY.txt</thirdPartyFilename>
            <excludedScopes>test,provided</excludedScopes>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>net.revelc.code.formatter</groupId>
        <artifactId>formatter-maven-plugin</artifactId>
        <version>${formatter.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>format</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <encoding>UTF-8</encoding>
          <configFile>${maven.multiModuleProjectDirectory}/eclipse-formatter.xml</configFile>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <configuration>
          <argLine>-XX:+EnableDynamicAgentLoading</argLine>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${surefire.version}</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${enforcer.version}</version>
        <executions>
          <execution>
            <id>enforce</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[17,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.8,)</version>
                </requireMavenVersion>
                <dependencyConvergence/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Generates a CycloneDX SBOM (target/bom.json + bom.xml) for each module,
           for supply-chain review and scanning of the published artifacts. -->
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <version>${cyclonedx.version}</version>
        <executions>
          <execution>
            <id>sbom</id>
            <phase>package</phase>
            <goals>
              <goal>makeBom</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!--
        Enforces the SPDX license header on every source file. `check` runs in the
        verify phase (and in CI), failing the build on a missing or altered header;
        `mvn license:format` stamps new files. The header uses `//` line comments
        (DOUBLESLASH_STYLE) on purpose: the eclipse formatter reformats block
        comments but leaves line comments alone, so the two plugins never fight.
      -->
      <plugin>
        <groupId>com.mycila</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>${licenseheader.version}</version>
        <configuration>
          <licenseSets>
            <licenseSet>
              <header>${maven.multiModuleProjectDirectory}/license-header.txt</header>
              <includes>
                <include>src/main/java/**/*.java</include>
                <include>src/test/java/**/*.java</include>
                <include>src/main/java-templates/**/*.java</include>
              </includes>
            </licenseSet>
          </licenseSets>
          <mapping>
            <java>DOUBLESLASH_STYLE</java>
          </mapping>
        </configuration>
        <executions>
          <execution>
            <id>check-license-headers</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      usb4java 1.3.0 bundles libusb4java natives for darwin-x86-64,
      linux-x86-64, linux-aarch64 and Windows, but NOT darwin-aarch64
      (Apple Silicon). On that platform we add the native explicitly. It is
      not published to Maven Central, so it must be built and installed into
      the local repository once:

        mvn install:install-file -Dfile=libusb4java-1.3.0-darwin-aarch64.jar \
          -DgroupId=org.usb4java -DartifactId=libusb4java -Dversion=1.3.0 \
          -Dclassifier=darwin-aarch64 -Dpackaging=jar

      On every other OS/arch this profile stays inactive and usb4java resolves
      the correct native transitively from Maven Central. It is inherited by the
      modules that put the USB code on their classpath.
    -->
    <profile>
      <id>macos-aarch64</id>
      <activation>
        <os>
          <family>mac</family>
          <arch>aarch64</arch>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.usb4java</groupId>
          <artifactId>libusb4java</artifactId>
          <version>${usb4java.version}</version>
          <classifier>darwin-aarch64</classifier>
        </dependency>
      </dependencies>
    </profile>

    <!--
      Release artifacts: source + javadoc jars, GPG signatures, and publishing to
      Maven Central via the Sonatype Central Portal. Active only with -Prelease.

      Before the first publish, confirm: (1) the net.nmoncho namespace is verified on
      central.sonatype.com; (2) a `central` server with a Central user token lives in
      settings.xml; (3) a GPG signing key is available. Then dry-run with
      `mvn -Prelease -DskipTests verify` before `deploy`.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.4.0</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <executions>
              <execution>
                <id>attach-javadoc</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
